# OPENROUTER_API_KEY: Required for plant vision identification, chat, and tips via OpenRouter
OPENROUTER_API_KEY="your-openrouter-api-key-here"

# Optional model overrides (defaults to google/gemini-2.5-flash)
# OPENROUTER_MODEL_VISION="google/gemini-2.5-flash"
# OPENROUTER_MODEL_CHAT="google/gemini-2.5-flash"
# OPENROUTER_MODEL_FAST="google/gemini-2.5-flash"

# PORT: Server port (defaults to 3000)
PORT=3000

# Optional app URL if deployed behind custom domain / Vercel
APP_URL="http://localhost:3000"
